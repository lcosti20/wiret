wiret 1
@id("mod_k3f9")
module game.demo

@capability("console.write")
extern func host.Log(message: string)

var runs: i32 = 0

macro DoOnce(in: exec, reset: exec) -> (out: exec) {
  state fired: bool

  exec Entry().in -> {
    exec Branch(
      .cond <- GetState fired()
    ).else -> {
      exec SetState fired(
        .value <- true
      )
      exec Exit out()
    }
  }.reset -> {
    exec SetState fired(
      .value <- false
    )
  }
}

macro ForRange(in: exec, first: i32, last: i32) -> (each: exec, done: exec, index: i32) {
  local i: i32

  node cur = GetLocal i()
  node test = Branch(
    .cond <- Le#<i32>(
      .a <- cur
      .b <- last
    )
  )

  exec Entry()
  exec SetLocal i(
    .value <- first
  )
  exec test.then -> {
    exec Sequence#count<2>().then0 -> {
      exec Exit each(
        .index <- cur
      )
    }.then1
    exec SetLocal i(
      .value <- Add#<i32>(
        .a <- cur
        .b <- 1
      )
    )
    goto test
  }.else -> {
    exec Exit done()
  }
}

@pure
func Clamp01(v: f32) -> (result: f32) = Min#<f32>(
  .a <- Max#<f32>(
    .a <- v
    .b <- 0.0
  )
  .b <- 1.0
)

func Divide(a: i32, b: i32) -> (result: i32) = Div#<i32>(
  .a <- a
  .b <- b
)

@pure
func Fib(n: i32) -> (result: i32) {
  exec Entry()
  exec Branch(
    .cond <- Lt#<i32>(
      .a <- n
      .b <- 2
    )
  ).then -> {
    exec Return(
      .result <- n
    )
  }.else -> {
    exec Return(
      .result <- Add#<i32>(
        .a <- Call Fib(
          .n <- Sub#<i32>(
            .a <- n
            .b <- 1
          )
        )
        .b <- Call Fib(
          .n <- Sub#<i32>(
            .a <- n
            .b <- 2
          )
        )
      )
    )
  }
}

@note("Logs Fib(i) for the even numbers 1..10, then SumTo(100).")
@id("fn_main")
func Main() {
  box {title="Report each even Fibonacci number", pos=(930, -40), size=(760, 600), color="#2E86C1"}

  node sum = Call SumTo{pos=(960, -200)}(
    .n <- 100
  )

  exec Entry{pos=(0, 0)}()
  exec SetVar runs{pos=(200, 0)}(
    .value <- Add#<i32>{pos=(150, 140)}(
      .a <- GetVar runs{pos=(-20, 140)}()
      .b <- 1
    )
  )
  exec Call host.Log{pos=(420, 0), label="Say hello"}(
    .message <- "Hello from Wiret!"
  )
  exec Macro ForRange{pos=(680, 0)}(
    .first <- 1
    .last <- 10
  ).each|index| -> {
    exec Branch{pos=(960, 0)}(
      .cond <- Eq#<i32>{pos=(800, 220)}(
        .a <- Rem#<i32>{pos=(640, 220)}(
          .a <- index
          .b <- 2
        )
        .b <- 0
      )
    ).then -> {
      exec Call host.Log{pos=(1240, 0)}(
        .message <- Call std.string.Concat{pos=(1400, 320)}(
          .a <- Call std.string.Concat{pos=(1400, 440)}(
            .a <- Call std.string.Concat{pos=(1160, 440)}(
              .a <- "Fib("
              .b <- Convert#<i32, string>{pos=(960, 440)}(
                .value <- index
              )
            )
            .b <- ") = "
          )
          @note("The Fib call is pure: it is re-evaluated at log_fib's evaluation point.")
          .b <- Convert#<i32, string>{pos=(1160, 320)}(
            .value <- Call Fib{pos=(960, 320)}(
              .n <- index
            )
          )
        )
      )
    }
  }.done -> {
    exec sum
    exec Call host.Log{pos=(1460, -280)}(
      .message <- Call std.string.Concat{pos=(1420, -120)}(
        .a <- "SumTo(100) = "
        .b <- Convert#<i32, string>{pos=(1200, -120)}(
          .value <- sum
        )
      )
    )
    exec Return{pos=(1720, -280)}()
  }
}

func SumTo(n: i32) -> (total: i32) {
  local acc: i32

  exec Entry()
  exec Macro ForRange(
    .first <- 1
    .last <- n
  ).each|index| -> {
    exec SetLocal acc(
      .value <- Add#<i32>(
        .a <- GetLocal acc()
        .b <- index
      )
    )
  }.done -> {
    exec Return(
      .total <- GetLocal acc()
    )
  }
}
