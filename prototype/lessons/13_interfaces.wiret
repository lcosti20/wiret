wiret 1
module lessons.interfaces

extern func host.Log(message: string) -> ()

@doc("Anything with an area and a name.")
interface Shape {
  func Area(self) -> (area: i32)
  func Name(self) -> (name: string)
}

@doc("A rectangle, width by height.")
class Rectangle impl Shape {
  width: i32 = 3
  height: i32 = 4

  @note("A rectangle's area is width times height.")
  func Area(self) -> (area: i32) {
    exec Entry{pos=(0, 0)}()
    exec Return{pos=(757, 0)}(
      .area <- Mul#<i32>{pos=(559, 68)}(
        .a <- GetField Rectangle.width{pos=(282, 68)}(
          .obj <- self
        )
        .b <- GetField Rectangle.height{pos=(283, 125)}(
          .obj <- self
        )
      )
    )
  }

  @note("Square inherits this, but gives its own Name.")
  func Name(self) -> (name: string) {
    exec Entry{pos=(0, 0)}()
    exec Return{pos=(250, 0)}(
      .name <- "Rectangle"
    )
  }
}

@doc("A square: a rectangle with equal sides.")
class Square : Rectangle {
  @note("Square gets Area from Rectangle and only renames itself, so it is a Shape too.")
  func Name(self) -> (name: string) {
    exec Entry{pos=(0, 0)}()
    exec Return{pos=(250, 0)}(
      .name <- "Square"
    )
  }
}

@doc("A triangle with a base and a height.")
class Triangle impl Shape {
  base: i32 = 4
  height: i32 = 3

  @note("Half of base times height.")
  func Area(self) -> (area: i32) {
    exec Entry{pos=(0, 0)}()
    exec Return{pos=(1010, -2)}(
      .area <- Div#<i32>{pos=(787, 71)}(
        .a <- Mul#<i32>{pos=(632, 71)}(
          .a <- GetField Triangle.base{pos=(338, 71)}(
            .obj <- self
          )
          .b <- GetField Triangle.height{pos=(338, 142)}(
            .obj <- self
          )
        )
        .b <- 2
      )
    )
  }

  @note("Its name.")
  func Name(self) -> (name: string) {
    exec Entry{pos=(0, 0)}()
    exec Return{pos=(250, 0)}(
      .name <- "Triangle"
    )
  }
}

@note("Lesson 13: Interfaces. An interface is a promise: any class that says 'impl Shape' has an Area and a Name. Rectangle and Triangle are not related, but both keep the promise, so one array can hold both and ask each for its area.")
@note("Try it: (1) Add a Circle class that implements Shape (the Source pane is easiest). (2) Remove Name from Triangle: Wiret says which method the promise is missing. (3) Make the square's sides 6.")
func Main() {
  local shapes: array#<Shape>

  node rect = New Rectangle{pos=(250, 0)}()
  node square = New Square{pos=(803, 0)}()
  node tri = New Triangle{pos=(1750, 0)}()
  node loop = Macro std.flow.ForEach#<Shape>{pos=(2250, 0)}(
    .array <- GetLocal shapes{pos=(2023, 98)}()
  )
  @note("Calling through the interface: each shape's own class decides what runs.")
  node area = Call Shape.Area{pos=(2656, -3)}(
    .self <- loop.item
  )
  node name = Call Shape.Name{pos=(2921, 20)}(
    .self <- loop.item
  )

  exec Entry{pos=(0, 0)}()
  exec rect
  exec ArrayAdd#<Shape> shapes{pos=(500, 0)}(
    .item <- rect
  )
  exec square
  exec SetField Rectangle.width{pos=(1000, 0)}(
    .obj <- square
    .value <- 5
  )
  exec SetField Rectangle.height{pos=(1250, 0)}(
    .obj <- square
    .value <- 5
  )
  exec ArrayAdd#<Shape> shapes{pos=(1500, 0)}(
    .item <- square
  )
  exec tri
  exec ArrayAdd#<Shape> shapes{pos=(1949, 0)}(
    .item <- tri
  )
  exec loop.each -> {
    exec area
    exec name
    exec Call host.Log{pos=(3649, 20)}(
      .message <- Call std.string.Concat{pos=(3445, 76)}(
        .a <- Call std.string.Concat{pos=(3185, 76)}(
          .a <- name
          .b <- ": area "
        )
        .b <- Convert#<i32, string>{pos=(3054, 177)}(
          .value <- area
        )
      )
    )
  }
}
