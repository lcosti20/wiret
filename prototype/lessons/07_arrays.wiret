wiret 1
module lessons.arrays

extern func host.Log(message: string)

#[note("Lesson 7: Arrays. An array is one variable that holds a list of values, in order. MakeArray builds a list from the items wired into it. Each item has a position (its index), and positions start at 0, not 1.")]
#[note("Try it: (1) Step (F11) and watch scores in the Variables panel of the Debugger tab. (2) Add a fifth score with another ArrayAdd. (3) Use ArrayGet::<i32> to print only the first score (index 0). (4) Ask ArrayGet for index 10 and read the error message.")]
func Main() {
  local scores: array::<i32>
  local total: i32
  #[note("ArrayAdd puts one more item on the end of the array. scores now holds 4 items.")]
  node add = ArrayAdd::<i32> scores
    .item <- 25
  node count = ArrayLength::<i32>
    .array <- list.value
  node count_text = Convert::<i32, string>
    .value <- count.length
  node entry = Entry
  node final = GetLocal total
  node item_text = Convert::<i32, string>
    .value <- loop.item
  node keep = SetLocal total
    .value <- plus.result
  node line = Call std.string.Concat
    .a <- part2.result
    .b <- item_text.result
  node list = GetLocal scores
  #[note("ForEach runs 'each' once for every item. item is the value, index is its position. After the last item it follows 'done'.")]
  node loop = Macro std.flow.ForEach::<i32>
    .array <- list.value
  node make = MakeArray::<i32> @count(3)
    .item0 <- 12
    .item1 <- 30
    .item2 <- 7
  node old = GetLocal total
  node part1 = Call std.string.Concat
    .a <- "Item "
    .b <- pos_text.result
  node part2 = Call std.string.Concat
    .a <- part1.result
    .b <- " is "
  node plus = Add::<i32>
    .a <- old.value
    .b <- loop.item
  node pos_text = Convert::<i32, string>
    .value <- loop.index
  node report = Call host.Log
    .message <- report_line.result
  node report_line = Call std.string.Concat
    .a <- report_start.result
    .b <- total_text.result
  node report_start = Call std.string.Concat
    .a <- count_text.result
    .b <- " scores, total "
  node say = Call host.Log
    .message <- line.result
  node start = SetLocal scores
    .value <- make.result
  node total_text = Convert::<i32, string>
    .value <- final.value

  flow {
    add -> loop
    entry -> start
    loop.each -> say
    loop.done -> report
    say -> keep
    start -> add
  }

  layout {
    add at (420, 0)
    count at (729, 284)
    count_text at (968, 284)
    entry at (0, 0)
    final at (1026, 376)
    item_text at (1330, -86)
    keep at (2004, -1)
    line at (1616, -191)
    list at (467, 124)
    loop at (715, 0)
    make at (-51, 75)
    old at (1620, 74)
    part1 at (1241, -191)
    part2 at (1427, -191)
    plus at (1831, 98)
    pos_text at (1036, -99)
    report at (1666, 224)
    report_line at (1482, 306)
    report_start at (1212, 284)
    say at (1802, -1)
    start at (200, 0)
    total_text at (1216, 376)
  }
}
