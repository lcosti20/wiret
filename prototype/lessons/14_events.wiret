wiret 1
module lessons.events

extern func host.Log(message: string) -> ()

@doc("A button that tells whoever is listening when it is clicked.")
class Button {
  dispatcher OnClick(times: i32)

  @note("Click counts its clicks in a state slot, which every button keeps for itself, then tells every listener with Broadcast.")
  func Click(self) {
    state clicks: i32

    exec Entry{pos=(0, 0)}()
    exec SetState clicks{pos=(250, 0)}(
      .value <- Add#<i32>{pos=(50, 110)}(
        .a <- GetState clicks{pos=(-141, 110)}()
        .b <- 1
      )
    )
    exec Broadcast Button.OnClick{pos=(500, 0)}(
      .obj <- self
      .times <- GetState clicks{pos=(300, 110)}()
    )
  }
}

@doc("Counts the clicks it hears.")
class Counter {
  heard: i32

  @note("Heard is a handler: its inputs match OnClick, so it can listen to a button.")
  func Heard(self, times: i32 = 1) {
    exec Entry{pos=(0, 0)}()
    exec SetField Counter.heard{pos=(581, 0)}(
      .obj <- self
      .value <- Add#<i32>{pos=(393, 78)}(
        .a <- GetField Counter.heard{pos=(213, 78)}(
          .obj <- self
        )
        .b <- 1
      )
    )
  }
}

@note("Announce is another handler, a plain function this time.")
func Announce(times: i32) {
  exec Entry{pos=(0, 0)}()
  exec Call host.Log{pos=(719, 0)}(
    .message <- Call std.string.Concat{pos=(452, 53)}(
      .a <- "Click number "
      .b <- Convert#<i32, string>{pos=(185, 73)}(
        .value <- times
      )
    )
  )
}

@note("Lesson 14: Events. A dispatcher is a list of listeners on an object: Bind adds one, Unbind removes one, and Broadcast calls them all. A listener is a delegate, made with CreateDelegate from a function, or from a method plus the object to call it on.")
@note("Try it: (1) Move the Unbind to the end: Announce hears all three clicks. (2) Make a second Counter and bind it too. (3) Change Heard to an event with a Delay: a delegate starts an event on its own, so Click does not wait.")
func Main() {
  node b = New Button{pos=(250, 0)}()
  node c = New Counter{pos=(500, 0)}()
  node announce = CreateDelegate Announce{pos=(381, 214)}()

  exec Entry{pos=(0, 0)}()
  exec b
  exec c
  exec Bind Button.OnClick{pos=(750, 0)}(
    .obj <- b
    .handler <- announce
  )
  exec Bind Button.OnClick{pos=(1000, 0)}(
    .obj <- b
    .handler <- CreateDelegate Counter.Heard{pos=(698, 154)}(
      .target <- c
    )
  )
  exec Call Button.Click{pos=(1250, 0)}(
    .self <- b
  )
  exec Call Button.Click{pos=(1500, 0)}(
    .self <- b
  )
  @note("After this, Announce stops listening, but the counter goes on.")
  exec Unbind Button.OnClick{pos=(1750, 0)}(
    .obj <- b
    .handler <- announce
  )
  exec Call Button.Click{pos=(2000, 0)}(
    .self <- b
  )
  exec Call host.Log{pos=(2250, 0)}(
    .message <- Call std.string.Concat{pos=(1981, 141)}(
      .a <- "The counter heard "
      .b <- Call std.string.Concat{pos=(1764, 161)}(
        .a <- Convert#<i32, string>{pos=(1522, 161)}(
          .value <- GetField Counter.heard{pos=(1276, 161)}(
            .obj <- c
          )
        )
        .b <- " clicks"
      )
    )
  )
}
