wiret 1
module lessons.fizzbuzz

extern func host.Log(message: string) -> ()

@note("Lesson 6: Challenge, FizzBuzz. For 1 to 15, print Fizz for multiples of 3, Buzz for multiples of 5, FizzBuzz for multiples of both, and otherwise the number. Rem gives the remainder: a number is a multiple of 3 when the remainder after dividing by 3 is 0.")
@note("Try it: (1) Predict the output, then Run. (2) Swap the order of check15 and check3 and see what breaks. (3) Add 'Bang' for multiples of 7.")
func Main() {
  exec Entry{pos=(0, 0)}()
  exec Macro std.flow.ForRange{pos=(200, 0)}(
    .first <- 1
    .last <- 15
  ).each(index) -> {
    @note("Check 15")
    @note("Why check 15 first? 15 is a multiple of 3 too. If check3 came first, 15 would only print Fizz.")
    exec Branch{pos=(788, 0)}(
      .cond <- Eq#<i32>{pos=(608, 64)}(
        .a <- Rem#<i32>{pos=(475, 64)}(
          .a <- index
          .b <- 15
        )
        .b <- 0
      )
    ).then -> {
      exec Call host.Log{pos=(972, -138)}(
        .message <- "FizzBuzz"
      )
    }.else -> {
      @note("Check 3")
      exec Branch{pos=(1043, 20)}(
        .cond <- Eq#<i32>{pos=(609, 154)}(
          .a <- Rem#<i32>{pos=(474, 156)}(
            .a <- index
            .b <- 3
          )
          .b <- 0
        )
      ).then -> {
        exec Call host.Log{pos=(1255, -140)}(
          .message <- "Fizz"
        )
      }.else -> {
        @note("Check 5")
        exec Branch{pos=(1282, 40)}(
          .cond <- Eq#<i32>{pos=(609, 246)}(
            .a <- Rem#<i32>{pos=(475, 246)}(
              .a <- index
              .b <- 5
            )
            .b <- 0
          )
        ).then -> {
          exec Call host.Log{pos=(1502, -141)}(
            .message <- "Buzz"
          )
        }.else -> {
          exec Call host.Log{pos=(1531, 60)}(
            .message <- Convert#<i32, string>{pos=(474, 346)}(
              .value <- index
            )
          )
        }
      }
    }
  }
}
