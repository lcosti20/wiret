wiret 1
module std.flow

macro DoN(in: exec, reset: exec, n: i32) -> (out: exec, counter: i32) @doc("Lets execution through at most n times, until reset.") {
  state count: i32
  node add = Add::<i32>
    .a <- cur.value
    .b <- 1
  node bump = SetState count
    .value <- add.result
  node clear = SetState count
    .value <- 0
  node cur = GetState count
  node entry = Entry
  node fire = Exit out
    .counter <- cur.value
  node more = Lt::<i32>
    .a <- cur.value
    .b <- entry.n
  node test = Branch
    .cond <- more.result

  flow {
    bump -> fire
    entry.in -> test
    entry.reset -> clear
    test.then -> bump
  }
}

macro DoOnce(in: exec, reset: exec) -> (out: exec) @doc("Lets execution through once, until reset.") {
  state fired: bool
  node check = Branch
    .cond <- flag.value
  node clear = SetState fired
    .value <- false
  node entry = Entry
  node fire = Exit out
  node flag = GetState fired
  node mark = SetState fired
    .value <- true

  flow {
    check.else -> mark
    entry.in -> check
    entry.reset -> clear
    mark -> fire
  }
}

macro FlipFlop(in: exec) -> (a: exec, b: exec, is_a: bool) @doc("Alternates between output a and output b each time it runs.") {
  state on_b: bool
  node check = Branch
    .cond <- flag.value
  node entry = Entry
  node exit_a = Exit a
    .is_a <- true
  node exit_b = Exit b
  node flag = GetState on_b
  node to_a = SetState on_b
    .value <- false
  node to_b = SetState on_b
    .value <- true

  flow {
    check.then -> to_a
    check.else -> to_b
    entry -> check
    to_a -> exit_a
    to_b -> exit_b
  }
}

macro ForEach::<T>(in: exec, array: array::<T>) -> (each: exec, done: exec, item: T, index: i32) @doc("Loops over an array: runs 'each' once for every item, in order (index counts 0, 1, 2, ...), then runs 'done'.") {
  local i: i32
  node bump = SetLocal i
    .value <- nxt.result
  node cmp = Lt::<i32>
    .a <- cur.value
    .b <- len.length
  node cur = GetLocal i
  node each_out = Exit each
    .item <- got.item
    .index <- cur.value
  node entry = Entry
  node finish = Exit done
  node got = ArrayGet::<T>
    .array <- entry.array
    .index <- cur.value
  node init = SetLocal i
    .value <- 0
  node len = ArrayLength::<T>
    .array <- entry.array
  node nxt = Add::<i32>
    .a <- cur.value
    .b <- 1
  node seq = Sequence @count(2)
  node test = Branch
    .cond <- cmp.result

  flow {
    bump -> test
    entry -> init
    init -> test
    seq.then0 -> each_out
    seq.then1 -> bump
    test.then -> seq
    test.else -> finish
  }
}

macro ForRange(in: exec, first: i32, last: i32) -> (each: exec, done: exec, index: i32) @doc("Runs 'each' once for every number from first to last (inclusive), then runs 'done'.") {
  local i: i32
  node bump = SetLocal i
    .value <- nxt.result
  node cmp = Le::<i32>
    .a <- cur.value
    .b <- entry.last
  node cur = GetLocal i
  node each_out = Exit each
    .index <- cur.value
  node entry = Entry
  node finish = Exit done
  node init = SetLocal i
    .value <- entry.first
  node nxt = Add::<i32>
    .a <- cur.value
    .b <- 1
  node seq = Sequence @count(2)
  node test = Branch
    .cond <- cmp.result

  flow {
    bump -> test
    entry -> init
    init -> test
    seq.then0 -> each_out
    seq.then1 -> bump
    test.then -> seq
    test.else -> finish
  }
}

macro Repeat(in: exec, times: i32) -> (body: exec, done: exec, index: i32) @doc("Runs 'body' the given number of times (index counts 0, 1, 2, ...), then runs 'done'.") {
  local i: i32
  node body_out = Exit body
    .index <- cur.value
  node bump = SetLocal i
    .value <- nxt.result
  node cmp = Lt::<i32>
    .a <- cur.value
    .b <- entry.times
  node cur = GetLocal i
  node entry = Entry
  node finish = Exit done
  node init = SetLocal i
    .value <- 0
  node nxt = Add::<i32>
    .a <- cur.value
    .b <- 1
  node seq = Sequence @count(2)
  node test = Branch
    .cond <- cmp.result

  flow {
    bump -> test
    entry -> init
    init -> test
    seq.then0 -> body_out
    seq.then1 -> bump
    test.then -> seq
    test.else -> finish
  }
}
